# Non-production / local only. Never commit real secrets.
# Set via `vercel env add` (type Secret) for Preview/Production.

OM_SPIKE_SECRET=
SESSION_SECRET=

# Google OIDC (OM-040). Create OAuth client in Google Cloud Console.
# https://developers.google.com/identity/protocols/oauth2/openid-connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://open-matchday-community.vercel.app/v1/auth/google/callback
COMMUNITY_PUBLIC_URL=https://open-matchday-community.vercel.app
WEBSITE_ORIGINS=https://openmatchday.github.io,http://127.0.0.1:4173,http://localhost:4173

# Local/CI only. Never enable on Vercel production.
OM_AUTH_TEST_MODE=1

# Injected by Vercel Marketplace Neon when provisioned (OM-008 choice).
# DATABASE_URL=
